# 默认忽略所有文件，下面用 ! 逐项“放行”真正需要进仓库的东西。
# 构建产物（build/、.gradle/、node_modules/、dist/、local-repo/、*.tgz、
# __pycache__ 等）都不会被放行。
*
!*/

# 根文档 / 忽略规则本身
!/LICENSE
!/README.md
!/README.zh-CN.md
!/CLAUDE.md
!.gitignore

# ---------------------------------------------------------------------------
# Python 实现（两个 PyPI 包：apkdiff-core / apkdiff）
# ---------------------------------------------------------------------------
!py/
!py/README.md
!py/README.zh-CN.md
!py/packages/
!py/packages/core/
!py/packages/core/pyproject.toml
!py/packages/core/LICENSE
!py/packages/core/README.md
!py/packages/core/README.zh-CN.md
!py/packages/core/src/
!py/packages/core/src/**/*.py

!py/packages/cli/
!py/packages/cli/pyproject.toml
!py/packages/cli/LICENSE
!py/packages/cli/README.md
!py/packages/cli/README.zh-CN.md
!py/packages/cli/src/
!py/packages/cli/src/**/*.py

!py/tests/
!py/tests/*.py
!py/tests/*.md
!py/tests/fixtures/
!py/tests/fixtures/**/*.apk
!py/tests/fixtures/**/mapping.txt
!py/tests/fixtures/complex/expected.json

!py/report-complex/
!py/report-complex/*

# ---------------------------------------------------------------------------
# Java 实现
# ---------------------------------------------------------------------------
!java/
!java/README.md
!java/README.zh-CN.md
!java/settings.gradle
!java/build.gradle
!java/gradle.properties
!java/gradlew
!java/gradlew.bat

!java/gradle/
!java/gradle/wrapper/
!java/gradle/wrapper/gradle-wrapper.jar
!java/gradle/wrapper/gradle-wrapper.properties

!java/apkdiff-core/
!java/apkdiff-core/build.gradle
!java/apkdiff-core/src/
!java/apkdiff-core/src/**/*.java
!java/apkdiff-core/src/main/resources/
!java/apkdiff-core/src/main/resources/**/*.html

!java/apkdiff-cli/
!java/apkdiff-cli/build.gradle
!java/apkdiff-cli/src/
!java/apkdiff-cli/src/**/*.java

!java/tests/
!java/tests/fixtures/
!java/tests/fixtures/**/*.apk
!java/tests/fixtures/**/mapping.txt
!java/tests/fixtures/complex/expected.json

# ---------------------------------------------------------------------------
# Node.js 实现（npm workspaces）
# ---------------------------------------------------------------------------
!js/
!js/README.md
!js/README.zh-CN.md
!js/package.json
!js/package-lock.json
!js/tsconfig.base.json

!js/packages/
!js/packages/core/
!js/packages/core/package.json
!js/packages/core/tsconfig.json
!js/packages/core/README.md
!js/packages/core/README.zh-CN.md
!js/packages/core/src/
!js/packages/core/src/**/*.ts

!js/packages/cli/
!js/packages/cli/package.json
!js/packages/cli/tsconfig.json
!js/packages/cli/README.md
!js/packages/cli/README.zh-CN.md
!js/packages/cli/src/
!js/packages/cli/src/**/*.ts

!js/tests/
!js/tests/*.cjs
!js/tests/fixtures/
!js/tests/fixtures/**/*.apk
!js/tests/fixtures/**/mapping.txt
!js/tests/fixtures/complex/expected.json

# CI 配置
!.github/
!.github/workflows/
!.github/workflows/*.yml

# APK 体积 CI 监控 case
!monitor-apk-size-ci/
!monitor-apk-size-ci/README.md
!monitor-apk-size-ci/README.zh-CN.md
!monitor-apk-size-ci/IMPLEMENTATION.md
!monitor-apk-size-ci/IMPLEMENTATION.zh-CN.md
!monitor-apk-size-ci/scripts/
!monitor-apk-size-ci/scripts/*.py
!monitor-apk-size-ci/github/
!monitor-apk-size-ci/github/README.md
!monitor-apk-size-ci/github/README.zh-CN.md
!monitor-apk-size-ci/github/action.yml
!monitor-apk-size-ci/github/example-pull-request.yml
!monitor-apk-size-ci/gitlab/
!monitor-apk-size-ci/gitlab/README.md
!monitor-apk-size-ci/gitlab/README.zh-CN.md
!monitor-apk-size-ci/gitlab/.gitlab-ci.yml
!monitor-apk-size-ci/gerrit-jenkins/
!monitor-apk-size-ci/gerrit-jenkins/README.md
!monitor-apk-size-ci/gerrit-jenkins/README.zh-CN.md
